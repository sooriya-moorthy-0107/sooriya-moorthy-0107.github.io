{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/#foundation",
      "permanent": true
    },
    {
      "source": "/projects.html",
      "destination": "/#artifacts",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/#contact",
      "permanent": true
    }
  ]
}
